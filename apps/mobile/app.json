{
  "expo": {
    "name": "Pixelbrowser",
    "slug": "pixelbrowser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixelbrowser.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pixelbrowser.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pixelbrowser uses the camera only to scan the sync QR code from your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "pixelbrowser",
    "backgroundColor": "#0b0b16"
  }
}
