{
  "expo": {
    "name": "Bit Browser",
    "slug": "pixelbrowser",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixelbrowser.app",
      "buildNumber": "200"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pixelbrowser.app",
      "versionCode": 200,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http",
              "mimeType": "text/html"
            },
            {
              "scheme": "https",
              "mimeType": "text/html"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Bit Browser uses the camera only to scan the sync QR code from your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b16"
        }
      ],
      "expo-sharing",
      "expo-screen-orientation",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bit Browser uses Face ID to unlock your saved passwords."
        }
      ]
    ],
    "scheme": "pixelbrowser",
    "backgroundColor": "#0b0b16"
  }
}
