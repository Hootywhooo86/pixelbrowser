{
  "name": "pixelbrowser",
  "private": true,
  "description": "Pixelbrowser monorepo: desktop + mobile apps and shared AI and sync packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop": "npm start -w @pixelbrowser/desktop",
    "mobile": "npm start -w @pixelbrowser/mobile",
    "sync-server": "npm start -w @pixelbrowser/sync-server",
    "test": "npm test -w @pixelbrowser/ai-core -w @pixelbrowser/sync-core -w @pixelbrowser/sync-server",
    "check": "npm run check -w @pixelbrowser/desktop"
  }
}
